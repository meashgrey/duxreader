import { cp, mkdir, readFile, rm } from "node:fs/promises";
import { resolve } from "node:path";

import { verifyUpstream } from "./vimium/upstream.mts";

// These classic content scripts share one global lexical scope and must keep
// upstream's load order. Keep the list in sync with vendor/vimium/manifest.json.
const contentScripts = [
  "lib/types.js",
  "lib/utils.js",
  "lib/keyboard_utils.js",
  "lib/dom_utils.js",
  "lib/rect.js",
  "lib/handler_stack.js",
  "lib/settings.js",
  "lib/find_mode_history.js",
  "content_scripts/mode.js",
  "content_scripts/ui_component.js",
  "content_scripts/link_hints.js",
  "content_scripts/vomnibar.js",
  "content_scripts/scroller.js",
  "content_scripts/marks.js",
  "content_scripts/mode_insert.js",
  "content_scripts/mode_find.js",
  "content_scripts/mode_key_handler.js",
  "content_scripts/mode_visual.js",
  "content_scripts/hud.js",
  "content_scripts/mode_normal.js",
  "content_scripts/vimium_frontend.js",
] as const;

const { root, version, revision } = await verifyUpstream();
const banner =
  `/*! Vimium ${version} (upstream ${revision.slice(0, 12)}), MIT; ` +
  "see public/third-party/vimium-MIT.txt. Generated by bun run vimium:build. */\n";

// The three overlay pages are React/Material 3 implementations in Duxreader.
const pageReplacements = new Map([
  ["pages/vomnibar_page.html", "vomnibar.html"],
  ["pages/hud_page.html", "hud.html"],
  ["pages/help_dialog_page.html", "help.html"],
]);

await rm("public/vimium", { recursive: true, force: true });
await rm("public/pages", { recursive: true, force: true });
await rm("public/icons", { recursive: true, force: true });
await rm("public/content_scripts", { recursive: true, force: true });
await rm("public/resources", { recursive: true, force: true });
await mkdir("public/vimium", { recursive: true });

let content = banner;
content += `
// Firefox's chrome alias is callback-only; Vimium awaits chrome.* instead.
if (globalThis.browser?.runtime?.getURL("")?.startsWith("moz-extension://"))
  globalThis.chrome = globalThis.browser;
`;
for (const path of contentScripts) {
  content += `\n// vendor/vimium/${path}\n`;
  content += await readFile(resolve(root, path), "utf8");
  content += "\n";
}
for (const [upstream, replacement] of pageReplacements)
  content = content.replaceAll(upstream, replacement);
await Bun.write("public/vimium/content.js", content);

// Vimium's background assumes its content script is the first manifest entry.
// Duxreader also ships content scripts, so locate the entry by its bundle path.
const background = await Bun.build({
  entrypoints: [resolve(root, "background_scripts/main.js")],
  target: "browser",
  format: "esm",
  minify: { whitespace: false, syntax: true, identifiers: false },
  banner,
  plugins: [
    {
      name: "duxreader-vimium-background-boundary",
      setup(build) {
        build.onLoad(
          { filter: /background_scripts[\\/]main\.js$/ },
          async ({ path }) => {
            if (resolve(path) !== resolve(root, "background_scripts/main.js"))
              return undefined;
            const source = await readFile(path, "utf8");
            const branch =
              "const contentScriptConfig = manifest.content_scripts[0];";
            if (source.split(branch).length !== 2)
              throw new Error("Vimium content script lookup changed upstream");
            let contents = source.replace(
              branch,
              'const contentScriptConfig = manifest.content_scripts.find((entry) => entry.js?.includes("vimium/content.js"));',
            );
            // Upstream's background lives in background_scripts/, so its
            // action icons use "../icons". Duxreader bundles it at the root.
            contents = contents.replaceAll(
              '"../icons/action_',
              '"icons/action_',
            );
            // Firefox MV2 exposes browser_action, not action. Keep the same
            // Vimium status icon on both manifest versions.
            contents = contents.replace(
              "chrome.action.setIcon(",
              "(chrome.action ?? chrome.browserAction).setIcon(",
            );
            return { contents, loader: "js" };
          },
        );
        build.onLoad({ filter: /lib[\\/]utils\.js$/ }, async ({ path }) => {
          if (resolve(path) !== resolve(root, "lib/utils.js")) return undefined;
          const source = await readFile(path, "utf8");
          const branch =
            'Utils.assert(request.handler != null, "Request is missing handler", request);';
          if (source.split(branch).length !== 2)
            throw new Error("Vimium runtime message boundary changed upstream");
          return {
            // Duxreader has its own background messages. Ignore messages that
            // do not carry Vimium's handler field instead of throwing.
            contents: source.replace(
              branch,
              "if (request.handler == null) return false;",
            ),
            loader: "js",
          };
        });
      },
    },
  ],
});
if (!background.success)
  throw new AggregateError(background.logs, "Vimium background build failed");
await Bun.write(
  "lib/vimium/background.js",
  await background.outputs[0]!.text(),
);

// Copy the upstream extension pages, assets, and styles that remain part of
// Vimium (options, command listing, search completion, favicon and icons).
await cp(resolve(root, "pages"), "public/pages", { recursive: true });
// Keep the upstream options controller and field contract; Duxreader owns
// the preference page's layout, labels, and Material 3 presentation.
await cp("lib/preferences/options.html", "public/pages/options.html");
await cp("lib/preferences/style.css", "public/vimium/preferences.css");
// Public pages are copied outside Vite's module graph. Bundle their imports:
// raw upstream scripts reference lib/ and background_scripts/ directories
// which do not exist in the packaged extension.
for (const page of ["options", "command_listing", "doc_search_completion"]) {
  const result = await Bun.build({
    entrypoints: [resolve(root, `pages/${page}.js`)],
    target: "browser",
    format: "esm",
  });
  if (!result.success)
    throw new AggregateError(result.logs, `Vimium ${page} build failed`);
  let code = await result.outputs[0]!.text();
  for (const [upstream, replacement] of pageReplacements)
    code = code.replaceAll(upstream, replacement);
  await Bun.write(`public/pages/${page}.js`, code);
}
const preferences = await Bun.build({
  entrypoints: ["lib/preferences/main.ts"],
  target: "browser",
  format: "esm",
});
if (!preferences.success)
  throw new AggregateError(preferences.logs, "Preferences build failed");
await Bun.write(
  "public/vimium/preferences.js",
  await preferences.outputs[0]!.text(),
);
await cp(resolve(root, "icons"), "public/icons", { recursive: true });
await mkdir("public/content_scripts", { recursive: true });
await cp(
  resolve(root, "content_scripts/vimium.css"),
  "public/content_scripts/vimium.css",
);
await cp(
  resolve(root, "content_scripts/file_urls.css"),
  "public/content_scripts/file_urls.css",
);
await mkdir("public/resources", { recursive: true });
await cp(resolve(root, "resources/tlds.txt"), "public/resources/tlds.txt");
await mkdir("public/third-party", { recursive: true });
await cp(resolve(root, "MIT-LICENSE.txt"), "public/third-party/vimium-MIT.txt");

// Upstream pages that remain (options, command listing, search completion)
// receive the same palette through a shared page theme. The Firefox alias has
// to execute before their module scripts, so it is a separate first script.
const firefoxApi = await Bun.build({
  entrypoints: ["lib/vimium/firefox-api.ts"],
  target: "browser",
  format: "esm",
  naming: "firefox-api.js",
});
if (!firefoxApi.success)
  throw new AggregateError(firefoxApi.logs, "Vimium Firefox API build failed");
await Bun.write(
  "public/vimium/firefox-api.js",
  await firefoxApi.outputs[0]!.text(),
);
const pageTheme = await Bun.build({
  entrypoints: ["lib/vimium/page-theme.ts"],
  target: "browser",
  format: "esm",
  naming: "page-theme.js",
});
if (!pageTheme.success)
  throw new AggregateError(pageTheme.logs, "Vimium page theme build failed");
await Bun.write(
  "public/vimium/page-theme.js",
  await pageTheme.outputs[0]!.text(),
);
await cp("lib/vimium/page-theme.css", "public/vimium/page-theme.css");
const headInjection =
  '<link rel="stylesheet" href="../vimium/page-theme.css">\n' +
  '    <script type="module" src="../vimium/page-theme.js"></script>';
for await (const file of new Bun.Glob("*.html").scan("public/pages")) {
  const path = `public/pages/${file}`;
  let html = await readFile(path, "utf8");
  // Module scripts run in document order; the alias must precede options.js.
  html = html.replace(
    "<head>",
    '<head>\n    <script type="module" src="../vimium/firefox-api.js"></script>',
  );
  const preferencesStyle =
    file === "options.html"
      ? '<link rel="stylesheet" href="../vimium/preferences.css">'
      : "";
  html = html.replace(
    "</head>",
    `    ${headInjection}\n    ${preferencesStyle}\n  </head>`,
  );
  await Bun.write(path, html);
}

console.log(
  `Built Vimium ${version} at ${revision.slice(0, 12)} (${contentScripts.length} content scripts).`,
);
