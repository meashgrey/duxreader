import { resolve } from "node:path";
import { copyFile, readFile } from "node:fs/promises";

import { verifyUpstream } from "./engine/upstream.mts";

// The gitlink pins upstream; adapters stay outside the submodule.
const { source, version, revision } = await verifyUpstream();
const imported = new Set<string>();
const plugin: Bun.BunPlugin = {
  name: "duxreader-engine-boundaries",
  setup(build) {
    build.onResolve({ filter: /^upstream:/ }, ({ path }) => ({
      path: resolve(source, path.slice(9)),
    }));
    build.onResolve({ filter: /^@plus\// }, ({ path }) => ({
      path:
        path === "@plus/utils/theme"
          ? resolve("scripts/engine/community-theme.js")
          : resolve(source, "stubs", `${path.slice(6)}.ts`),
    }));
    build.onResolve({ filter: /^\.\/modify-colors$/ }, () => ({
      path: resolve("scripts/engine/color-policy.js"),
    }));
    build.onResolve({ filter: /^\.\/network$/ }, ({ importer }) =>
      importer.includes("dynamic-theme")
        ? { path: resolve("scripts/engine/network.js") }
        : undefined,
    );
    build.onLoad({ filter: /\.ts$/ }, async ({ path }) => {
      if (path.startsWith(`${source}/`)) imported.add(path);
      let contents = await readFile(path, "utf8");
      // Use the dedicated MAIN-world transport on both browser families while
      // keeping upstream platform detection based on the actual user agent.
      if (path === resolve(source, "inject/dynamic-theme/index.ts")) {
        const branch = "if (__CHROMIUM_MV3__) {";
        if (contents.split(branch).length !== 2)
          throw new Error("Proxy transport boundary changed upstream");
        contents = contents.replace(branch, "if (true) {");
      }
      if (
        path === resolve(source, "inject/dynamic-theme/stylesheet-modifier.ts")
      ) {
        // Keep upstream's in-memory sentinels and late-variable subscriptions.
        // They have no CSS meaning and need not be inherited across the DOM.
        const branch = "if (value) {";
        if (contents.split(branch).length !== 2)
          throw new Error("Variable output boundary changed upstream");
        contents = contents.replace(
          branch,
          "if (value && !property.startsWith('--darkreader-placeholder-')) {",
        );
        // Identity comes from the declaration object and numeric varKey, not
        // this never-emitted label. Share its string instead of allocating one
        // unique name per unused variable.
        const label = "property: `--darkreader-placeholder-${varKey}`";
        if (contents.split(label).length !== 2)
          throw new Error("Variable sentinel boundary changed upstream");
        contents = contents.replace(
          label,
          "property: '--darkreader-placeholder-unused'",
        );
      }
      return { contents, loader: "ts" };
    });
  },
};
const result = await Bun.build({
  entrypoints: ["scripts/engine/kernel.js", "scripts/engine/proxy.js"],
  outdir: "lib/engine",
  target: "browser",
  format: "esm",
  minify: { whitespace: false, syntax: true, identifiers: false },
  define: Object.fromEntries(
    [
      "__DEBUG__",
      "__CHROMIUM_MV2__",
      "__FIREFOX_MV2__",
      "__THUNDERBIRD__",
      "__TEST__",
      "__PLUS__",
    ]
      .map((name) => [name, "false"])
      .concat([["__CHROMIUM_MV3__", "false"]]),
  ),
  plugins: [plugin],
  banner: `/*! Dark Reader ${version}, MIT; see vendor/darkreader/LICENSE. Generated by bun run engine:build. */`,
});
if (!result.success)
  throw new AggregateError(result.logs, "Engine build failed");
await copyFile(
  "vendor/darkreader/LICENSE",
  "public/third-party/darkreader-MIT.txt",
);
console.log(
  `Built Dark Reader ${version} at ${revision.slice(0, 12)} (${imported.size} source files).`,
);
