{
  "name": "duxreader",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:firefox:manual": "DUXREADER_NO_BROWSER=1 wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test:bridge": "cargo test --workspace",
    "test:bridge:integration": "cargo build --release && bun scripts/test-bridge.mjs",
    "build:bridge": "cargo build --release",
    "prepare:bridge": "bun scripts/prepare-bridge.mjs",
    "check": "bun run typecheck && bun run test:bridge && bun run test:bridge:integration && bun run build && bun run build:firefox",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "7.0.2",
    "web-ext": "10.8.0",
    "wxt": "0.21.5"
  }
}
