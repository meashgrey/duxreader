{
  "name": "duxreader",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run engine:build && wxt",
    "dev:firefox": "bun run engine:build && DUXREADER_NO_BROWSER=1 wxt -b firefox",
    "dev:firefox:auto": "bun run engine:build && wxt -b firefox",
    "dev:firefox:manual": "bun run engine:build && DUXREADER_NO_BROWSER=1 wxt -b firefox",
    "build": "bun run engine:build && wxt build",
    "build:firefox": "bun run engine:build && wxt build -b firefox",
    "zip": "bun run engine:build && wxt zip",
    "zip:firefox": "bun run engine:build && wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "test:browser": "bun scripts/test-engine-browser.mjs",
    "benchmark": "bun scripts/benchmark-renderer.mjs",
    "benchmark:idle": "bun scripts/benchmark-idle.mjs",
    "benchmark:interaction": "bun scripts/benchmark-interaction.mjs",
    "test:bridge": "cargo test --workspace",
    "test:bridge:integration": "cargo build --release && bun scripts/test-bridge.mjs && bun scripts/test-bridge-idle.mjs",
    "build:bridge": "cargo build --release",
    "prepare:bridge": "bun scripts/prepare-bridge.mjs",
    "install:bridge": "bun scripts/install-bridge.mjs",
    "check": "bun run typecheck && bun run test && bun run test:bridge && bun run test:bridge:integration && bun run build && bun run build:firefox",
    "postinstall": "bun run engine:build && wxt prepare",
    "engine:build": "bun scripts/build-engine.mjs"
  },
  "dependencies": {
    "@lit/react": "1.0.8",
    "@material/web": "2.5.0",
    "color-name": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/color-name": "2.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "7.0.2",
    "web-ext": "10.8.0",
    "wxt": "0.21.5"
  }
}
